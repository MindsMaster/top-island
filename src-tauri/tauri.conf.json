{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "island-spike",
  "version": "0.0.1",
  "identifier": "cc.azuramc.topisland.spike",
  "build": {
    "frontendDist": "../spike-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "island",
        "title": "island-spike",
        "width": 480,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
