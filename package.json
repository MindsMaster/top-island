  },
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build",
    "dist": "tauri build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\" vite.config.ts eslint.config.mjs crates/island-cloudmusic-bridge/js/bridge.js && cargo fmt --all",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss}\" vite.config.ts eslint.config.mjs crates/island-cloudmusic-bridge/js/bridge.js && cargo fmt --all --check"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@tauri-apps/api": "^2.11.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "^3.9.8",
    "sass-embedded": "^1.104.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "private": true
