{
  "name": "top-island",
  "version": "0.0.1",
  "description": "Top Island",
  "main": "dist/main.js",
  "author": {
    "name": "an5w1r@163.com"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "dist:dir": "node scripts/build.mjs && electron-builder --dir",
    "dist": "node scripts/build.mjs && electron-builder --win",
    "dist:portable": "node scripts/build.mjs && electron-builder --win portable",
    "native:build": "node scripts/build-native.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\" \"electron/**/*.ts\" \"shared/**/*.ts\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.9.5",
    "sass-embedded": "^1.83.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.topisland.app",
    "productName": "TopIsland",
    "asar": true,
    "asarUnpack": [
      "dist/read-worker.js",
      "dist/package.json",
      "node_modules/better-sqlite3-multiple-ciphers/**"
    ],
    "compression": "normal",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/**/*.map",
      "node_modules/better-sqlite3-multiple-ciphers/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*",
          "!*.old"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.exe"
    }
  },
  "private": true
}
